# Confirmed canonical origin. Must be a public HTTP(S) origin, not a URL path.
SITE_URL=https://useawsm.web.id
# Set false for staging/preview on generic hosts. Rebuild after changing SEO env.
# VERCEL_ENV=preview automatically disables indexing, even if this is true.
SITE_INDEXABLE=true
# Optional override of the owner-supplied Google verification token already in code.
# GOOGLE_SITE_VERIFICATION=
# Optional Bing verification token; no Bing meta is emitted without it.
# BING_SITE_VERIFICATION=
